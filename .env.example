# Which data store the app talks to.
#   json     - local file store in .data/ (development only, never on Vercel)
#   supabase - production source of truth
# Defaults to supabase when the Supabase variables below are set.
DATA_BACKEND=json

# Supabase (required when DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must match the tenant row created by supabase/seed.sql
SUPERMED_TENANT_ID=11111111-1111-1111-1111-111111111111
